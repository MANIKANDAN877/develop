APP_ENV=production
ALLOW_LOCAL_DEV_UNAUTH=false
AUTH_SECRET_KEY=replace-with-a-long-random-secret
SESSION_TOKEN_TTL_MINUTES=120
RATE_LIMIT_PER_MINUTE=60
FRONTEND_URL=https://your-frontend-domain.vercel.app
BACKEND_URL=https://your-backend-domain.onrender.com
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app,https://localhost:5173,http://localhost:5173

PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=replace-with-paypal-client-id
PAYPAL_CLIENT_SECRET=replace-with-paypal-client-secret
PAYPAL_LIVE_PAYOUTS_ENABLED=false
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEB_BASE=https://www.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=replace-with-paypal-webhook-id

# For real-money transfers: set PAYPAL_MODE=live, PAYPAL_API_BASE=https://api-m.paypal.com,
# PAYPAL_WEB_BASE=https://www.paypal.com, and ensure the business account is approved for live payouts
# in a supported country before enabling PAYPAL_LIVE_PAYOUTS_ENABLED=true.

DATABASE_URL=postgresql://username:password@host:5432/paypal_fraud

SARVAM_API_KEY=replace-with-sarvam-api-key
SARVAM_MODEL=sarvam-105b
SARVAM_API_BASE=https://api.sarvam.ai
